
def gv
pipeline {
agent any
 
options {
    skipDefaultCheckout()
}

environment{
NEW_VERSION = '1.1'
TEST_CREDENTIALS = credentials('test-credentials')
}

//tools{}

parameters{
    string (name: 'Environment', defaultValue: '', description: '')
    choice (name: 'Version', choices: ['1', '2'], description: '')
    booleanParam (name: 'IsValid', defaultValue: true, description: '')
}


stages {
stage ('Checkout') {
        steps{
            checkout(scm)
            echo "checkout"
        }
    }
stage('test'){
    when{
        expression{
            env.BRANCH_NAME == "master" || env.BRANCH_NAME == "dev"
        }
    }
        steps{
            echo "Branch name  is: ${env.BRANCH_NAME}"
            echo "Version is ${NEW_VERSION}"
               withCredentials([
                    usernamePassword(credentialsId: 'test-credentials', usernameVariable: 'username', passwordVariable: 'password'),
                ]) {
                        echo "User name is ${username}"
                        echo "Password is ${password}"
                }
        }
    }
stage ('Restore Packages') { 
  steps {
                script{ 
             echo "restore"              
            gv = load "script.groovy"           
          }
        }
}
stage('Build') {
    steps {
        script{
            gv.buildApp()
      }
   }
}
stage('Deploy') { 
 	steps {
 		echo "deploy"
 		}  
    } 
 }

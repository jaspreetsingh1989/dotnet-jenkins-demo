pipeline {
agent any
 
options {
    skipDefaultCheckout()
}

environment{
NEW_VERSION = '1.1'
TEST_CREDENTIALS = credentials('test-credentials')
}


stages {
stage ('Checkout') {
        steps{
            checkout(scm)
            echo "checkout"
        }
    }
stage('test'){
    when{
        expression{
            env.BRANCH_NAME == "master" || env.BRANCH_NAME == "dev"
        }
    }
        steps{
            echo "Branch name  is: ${env.BRANCH_NAME}"
            echo "Version is ${NEW_VERSION}"
               withCredentials([
                    usernamePassword(credentials: 'test-credentials', usernameVariable: 'username', passwordVariable: 'password'),
                ]) {
                        echo "User name is ${username}"
                        echo "Password is ${password}"
                }
        }
    }
stage ('Restore Packages') {     
         steps {
             echo "restore"            
          }
        }

stage('Build') {
     steps {
            echo "build"
      }
   }
stage('Deploy') { 
 	steps {
 		echo "deploy"
 		}  
    } 
 }
